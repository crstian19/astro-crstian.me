---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageTitle from "@components/base/PageTitle.astro";
import Projects from "@components/Projects";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
	.filter((project) => !project.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = [...new Set(projects.flatMap((project) => project.data.tags))].sort((a, b) => a.localeCompare(b));
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <PageTitle title={PROJECTS.TITLE} introduce="Tools, side projects and experiments. Most of them are open source." />
  <div class="animate pb-6">
    <Projects client:load tags={tags} data={projects} />
  </div>
</PageLayout>
