---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageTitle from "@components/base/PageTitle.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { SEARCH } from "@consts";

const data = (await getCollection("projects")).filter((project) => !project.data.draft);
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <PageTitle eyebrow="Scanner" title={SEARCH.TITLE} introduce="Search every project by keyword." />
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data}/>
    </div>
  </BottomLayout>
</PageLayout>