---
import PageLayout from "@layouts/PageLayout.astro";
import StackCard from "@components/StackCard.astro";
import ArrowCard from "@components/ArrowCard";
import ProfileCard from "@components/profile-card/ProfileCard.svelte";
import { SITE, SOCIALS, STACK } from "@consts";
import { getCollection } from "astro:content";
import "@components/ckad-card/base.css";
import "@components/profile-card/profile.css";
import fs from "node:fs";
import path from "node:path";

import { generateProfileAscii } from "../components/profile-card/ascii-gen.js";

const profileDir = path.join(process.cwd(), "public/assets/profiles");
const excludedFiles = ["profile.jpg", "nobg-fushimi-noenhance.png", "bg.webp", "no-bg.webp"];

const profileImages: (string | { bg: string, fg: string })[] = [
  ...fs.readdirSync(profileDir)
    .filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f) && !excludedFiles.includes(f))
    .map((f: string) => `/assets/profiles/${f}`),
  { bg: "/assets/profiles/bg.webp", fg: "/assets/profiles/no-bg.webp" },
  "/assets/profiles/profile.jpg"
];

const selectedImage = profileImages[Math.floor(Math.random() * profileImages.length)];
const precomputedAscii = await generateProfileAscii(selectedImage);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const stack = ([
	"vllm",
	"litellm",
	"k8s",
	"aws",
	"digitalocean",
	"azure",
	"gcp",
	"argo",
	"kong",
	"github-actions",
	"gitlab-ci",
	"vault",
	"traefik",
	"nginx",
	"postgresql",
	"grafana",
	"prometheus",
	"python",
	"terraform",
	"golang",
	"astro",
	"arch",
] as const).map(icon => ({ icon, ...STACK[icon] }));
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- HERO -->
  <section class="relative min-h-screen w-full flex items-center justify-center px-5 pt-24 pb-16">
    <div class="text-center flex flex-col items-center">

      <!-- Profile pic with orbit rings -->
      <div class="animate relative mb-8">
        <div class="orbit orbit-1" aria-hidden="true"><span></span></div>
        <div class="orbit orbit-2" aria-hidden="true"><span></span></div>
        <ProfileCard
          client:visible
          images={profileImages}
          selectedItem={selectedImage as any}
          precomputedAscii={precomputedAscii as any}
        />
      </div>

      <div class="animate eyebrow flex items-center gap-2 rounded-full border border-black/10 dark:border-white/10 bg-white/40 dark:bg-white/[0.03] backdrop-blur-md px-3 py-1.5">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        Hello, I am Cristian
      </div>

      <h1 class="animate mt-5 text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold uppercase leading-[0.95] text-black dark:text-white">
        Site Reliability<br /><span class="gradient-text">Engineer</span>
      </h1>

      <p class="animate mt-6 max-w-xl text-sm md:text-base lg:text-lg text-black/60 dark:text-white/60">
        Using Linux doesn't make you smart, being smart makes you use Linux.
      </p>

      <div id="ctaButtons" class="animate flex flex-wrap gap-3 justify-center mt-8">
        <a href="https://blog.crstian.me/" target="_blank" class="btn-primary">
          Read my blog
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
        <a href="/work" class="btn-ghost">
          View my work
        </a>
      </div>
    </div>

    <a href="#about" aria-label="Scroll down" class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 eyebrow flex flex-col items-center gap-2 [@media(max-height:1000px)]:hidden">
      <span>Scroll</span>
      <span class="block h-10 w-px bg-gradient-to-b from-current to-transparent"></span>
    </a>
  </section>

  <div class="relative">
    <div id="about" class="mx-auto max-w-screen-md p-5 space-y-6 pb-16 scroll-mt-24">

      <!-- About Section -->
      <section class="animate glass p-6 md:p-8">
        <p class="eyebrow mb-4">01 / About</p>
        <article class="pb-0">
          <p>I am a <b><i>SRE/Devops Engineer</i></b>, and technology enthusiast with many hobbies.</p>
          <p>As a saying from my country goes, I consider myself a "Jack of all trades, master of none."</p>
          <p>As short term goals I would like to improve my knowledge about software architecture and learn Golang.</p>
        </article>
      </section>

      <!-- Tech Stack Section -->
      <section class="animate glass p-6 md:p-8">
        <p class="eyebrow">02 / Stack</p>
        <h2 class="mt-2 text-2xl font-semibold text-black dark:text-white">
          Tech & Tools
        </h2>
        <div class="flex flex-wrap items-center gap-2 mt-5">
          {stack.map(item => (
            <StackCard
              text={item.text}
              icon={item.icon}
              href={item.href}
            />
          ))}
        </div>
      </section>

      <!-- Recent Projects Section -->
      <section class="animate pt-6">
        <div class="flex items-end justify-between mb-4 px-1">
          <div>
            <p class="eyebrow">03 / Launches</p>
            <h2 class="mt-2 text-2xl font-semibold text-black dark:text-white">
              Recent Projects
            </h2>
          </div>
          <a href="/projects" class="group eyebrow flex items-center gap-1 hover:text-black dark:hover:text-white blend">
            See all projects
            <span class="inline-block group-hover:translate-x-1 blend">&rarr;</span>
          </a>
        </div>
        <ul class="space-y-3">
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Contact Section -->
      <section class="animate glass p-6 md:p-8 overflow-hidden">
        <div class="contact-glow" aria-hidden="true"></div>
        <p class="eyebrow">04 / Transmission</p>
        <h2 class="mt-2 text-2xl font-semibold text-black dark:text-white">
          Let's Connect
        </h2>
        <p class="mt-1">
          Reach out to me via email or on social media.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-5">
          {SOCIALS.map(social => (
            <a href={social.HREF} target="_blank" class="group flex items-center gap-3 rounded-xl border border-black/10 dark:border-white/10 bg-white/30 dark:bg-white/[0.02] px-4 py-3 hover:border-black/25 dark:hover:border-white/25 hover:bg-white/60 dark:hover:bg-white/[0.06] blend">
              <svg class="size-5 fill-current shrink-0 opacity-70 group-hover:opacity-100 blend">
                <use href={`/social.svg#${social.ICON}`} />
              </svg>
              <span class="flex flex-col min-w-0">
                <span class="eyebrow !text-[10px]">{social.NAME}</span>
                <span class="truncate text-sm text-black dark:text-white">{social.TEXT}</span>
              </span>
              <span class="ml-auto opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 blend">&rarr;</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 9999px;
    border: 1px dashed rgb(var(--accent-1) / 0.35);
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: spin 30s linear infinite;
  }
  .orbit span {
    position: absolute;
    top: -4px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgb(var(--accent-2));
    box-shadow: 0 0 12px 2px rgb(var(--accent-2) / 0.8);
  }
  .orbit-1 { width: 140%; height: 140%; }
  .orbit-2 {
    width: 175%;
    height: 175%;
    border-color: rgb(var(--accent-3) / 0.2);
    animation-duration: 55s;
    animation-direction: reverse;
  }
  .orbit-2 span {
    background: rgb(var(--accent-3));
    box-shadow: 0 0 12px 2px rgb(var(--accent-3) / 0.8);
  }
  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  .scroll-cue span:last-child {
    animation: cue 2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
  .contact-glow {
    position: absolute;
    right: -20%;
    top: -60%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 9999px;
    background: radial-gradient(circle, rgb(var(--accent-3) / 0.25), transparent 70%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit, .scroll-cue span:last-child { animation: none; }
  }
</style>
