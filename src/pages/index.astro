---
import PageLayout from "@layouts/PageLayout.astro";
import SectionDivider from "@components/base/SectionDivider.astro";
import SkillsShowcase from "@components/base/SkillsShowcase.astro";
import ProjectRow from "@components/ProjectRow.astro";
import ProfileCard from "@components/profile-card/ProfileCard.svelte";
import { SITE, SOCIALS } from "@consts";
import { getCollection } from "astro:content";
import { formatDate, formatMonth } from "@lib/utils";
import { getLatestPosts } from "@lib/blog";
import "@components/ckad-card/base.css";
import "@components/profile-card/profile.css";
import fs from "node:fs";
import path from "node:path";

import { generateProfileAscii } from "../components/profile-card/ascii-gen.js";

const profileDir = path.join(process.cwd(), "public/assets/profiles");
const excludedFiles = ["profile.jpg", "nobg-fushimi-noenhance.png", "bg.webp", "no-bg.webp"];

const profileImages: (string | { bg: string; fg: string })[] = [
  ...fs
    .readdirSync(profileDir)
    .filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f) && !excludedFiles.includes(f))
    .map((f: string) => `/assets/profiles/${f}`),
  { bg: "/assets/profiles/bg.webp", fg: "/assets/profiles/no-bg.webp" },
  "/assets/profiles/profile.jpg",
];

const selectedImage = profileImages[Math.floor(Math.random() * profileImages.length)];
const precomputedAscii = await generateProfileAscii(selectedImage);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const work = (await getCollection("work")).sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());

const posts = await getLatestPosts(3);
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <!-- Hero -->
  <section class="px-6 sm:px-8 pt-10 pb-10">
    <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-8">
      <div class="flex-1 min-w-0">
        <div class="animate inline-flex items-center gap-2 text-xs font-mono text-muted-foreground mb-4">
          <span class="relative flex size-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full size-2 bg-emerald-400"></span>
          </span>
          SRE @ Helmcode · Murcia, Spain
        </div>
        <h1 class="animate flex flex-col gap-2">
          <span class="text-4xl sm:text-5xl tracking-tight gradient-text w-fit pb-1">Cristian Gutiérrez</span>
          <span class="text-muted-foreground font-light text-xl sm:text-2xl tracking-wide text-balance">
            SRE / AI Platform Engineer
          </span>
        </h1>
        <div class="animate pro text-muted-foreground text-pretty mt-4">
          <p>
            I enjoy running infrastructure as an SRE, both at work and at home, where I have three clusters in my homelab. Lately
            I spend my days on LLM inference: GPUs, vLLM and the platform around it. I try to make every tool I build open source
            and give back to the community as much as I can 💜
          </p>
        </div>
        <div class="animate mt-6 flex flex-wrap items-center gap-3">
          <a href="https://blog.crstian.me/" target="_blank" class="btn-primary">
            Read my blog
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a href="/work" class="btn-ghost">View my work</a>
        </div>
        <div class="animate mt-6 flex gap-5">
          {SOCIALS.map((social) => (
            <a
              href={social.HREF}
              target="_blank"
              rel={social.NAME === "Mastodon" ? "me noopener" : "noopener"}
              aria-label={social.NAME}
              title={social.NAME}
              class="group -m-1 p-1 rounded-lg"
            >
              <svg class="size-6 fill-current text-muted-foreground transition-all duration-300 group-hover:text-primary group-hover:rotate-6" aria-hidden="true">
                <use href={`/social.svg#${social.ICON}`} />
              </svg>
            </a>
          ))}
        </div>
      </div>
      <div class="animate profile-slot shrink-0 mx-auto sm:mx-0">
        <ProfileCard client:visible images={profileImages} selectedItem={selectedImage as any} precomputedAscii={precomputedAscii as any} />
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Experience -->
  <section class="px-6 sm:px-8 py-8 pb-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="section-title">Experience</h2>
        <p class="section-sub">Where I have been keeping things up.</p>
      </div>
      <a href="/work" class="group link-muted text-sm mb-6 whitespace-nowrap">
        Full log <span class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
    <ol class="relative border-l border-border ml-1.5 space-y-6">
      {work.map((entry, i) => (
        <li class="relative pl-6">
          <span
            class:list={[
              "absolute -left-[5px] top-1.5 size-[9px] rounded-full border-2",
              i === 0 ? "border-primary bg-primary shadow-[0_0_12px_oklch(var(--brand))]" : "border-border bg-background",
            ]}
            aria-hidden="true"
          ></span>
          <div class="font-mono text-xs text-muted-foreground">
            {formatMonth(entry.data.dateStart)} — {formatMonth(entry.data.dateEnd)}
          </div>
          <div class="mt-1 font-medium">
            {entry.data.role}
            <span class="text-muted-foreground font-normal">at</span>
            <span class={i === 0 ? "text-primary" : ""}>{entry.data.company}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <SectionDivider />

  <!-- Stack -->
  <section class="py-8 pb-10">
    <div class="px-6 sm:px-8">
      <h2 class="section-title">Tech &amp; tools</h2>
      <p class="section-sub">What I work with, day to day and at home.</p>
    </div>
    <SkillsShowcase
      rows={[
        { direction: "left", skills: ["vllm", "litellm", "k8s", "argo", "golang", "python", "astro", "typescript"] },
        { direction: "right", skills: ["aws", "gcp", "azure", "digitalocean", "terraform", "vault", "kong", "traefik", "nginx"] },
        { direction: "left", skills: ["prometheus", "grafana", "postgresql", "docker", "github-actions", "gitlab-ci", "arch", "tailwind"] },
      ]}
    />
  </section>

  <SectionDivider />

  <!-- Projects -->
  <section class="py-8 pb-6">
    <div class="px-6 sm:px-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="section-title">Projects</h2>
        <p class="section-sub">Recent things I have built.</p>
      </div>
      <a href="/projects" class="group link-muted text-sm mb-6 whitespace-nowrap">
        All projects <span class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
    <div>
      {projects.map((project) => <ProjectRow entry={project} />)}
    </div>
  </section>

  {
    posts.length > 0 && (
      <>
        <SectionDivider />
        <section class="py-8 pb-6">
          <div class="px-6 sm:px-8 flex items-end justify-between gap-4">
            <div>
              <h2 class="section-title">From the blog</h2>
              <p class="section-sub">Latest posts on blog.crstian.me.</p>
            </div>
            <a href="https://blog.crstian.me/" target="_blank" class="group link-muted text-sm mb-6 whitespace-nowrap">
              Read more <span class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={post.link} target="_blank" class="group block px-6 sm:px-8 py-4 hover:bg-muted/30 transition-colors">
                  <div class="font-mono text-xs text-muted-foreground">{formatDate(post.date)}</div>
                  <div class="mt-1 font-semibold text-lg/snug group-hover:text-primary transition-colors">{post.title}</div>
                  <p class="mt-1 text-sm text-muted-foreground line-clamp-2">{post.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  <SectionDivider />

  <!-- Contact -->
  <section class="px-6 sm:px-8 py-8 pb-10">
    <h2 class="section-title">Let's connect</h2>
    <p class="section-sub">Reach out by email or on social media.</p>
    <div class="flex flex-wrap gap-2">
      {SOCIALS.map((social) => (
        <a href={social.HREF} target="_blank" rel={social.NAME === "Mastodon" ? "me noopener" : "noopener"} class="pill">
          <svg class="size-4 fill-current shrink-0" aria-hidden="true"><use href={`/social.svg#${social.ICON}`} /></svg>
          <span>{social.TEXT}</span>
        </a>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .profile-slot {
    width: 200px;
  }
  @media (min-width: 640px) {
    .profile-slot {
      width: 220px;
    }
  }
</style>
