---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE } from "@consts";
---

<PageLayout title="404" description={SITE.DESCRIPTION}>
  <section class="frame min-h-[100svh] flex flex-col items-center justify-center text-center">
    <p class="font-mono text-xs text-muted-foreground tracking-[0.3em] uppercase">Signal lost</p>
    <h1 class="mt-4 display text-[9rem] sm:text-[14rem] leading-none gradient-text">404</h1>
    <p class="mt-4 text-muted-foreground text-pretty max-w-sm">
      This page drifted out of orbit. Nothing to find here, only stars.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="https://blog.crstian.me/" target="_blank" class="btn-ghost">Read the blog</a>
    </div>
  </section>
</PageLayout>
