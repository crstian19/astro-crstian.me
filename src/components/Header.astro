---
import { LINKS, SITE } from "@consts";
import Avatar from "@components/base/Avatar.astro";
import HeaderLink from "@components/base/HeaderLink.astro";
import ThemeToggle from "@components/base/ThemeToggle.astro";
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="flex items-center justify-between gap-4 px-4 sm:px-8 lg:px-10 h-16 sm:h-20">
    <a href="/" class="flex items-center gap-3 select-none shrink-0" aria-label="Home">
      <Avatar height={40} class="transition-transform hover:-rotate-6" />
      <span class="hidden lg:block font-serif font-medium tracking-tight">{SITE.AUTHOR}</span>
    </a>

    <nav class="nav-pill flex items-center rounded-full border px-1 py-1">
      {
        LINKS.filter((link) => link.HREF !== "/").map((link) => {
          const external = link.HREF.startsWith("http");
          return (
            <HeaderLink href={link.HREF} external={external} reload={link.RELOAD}>
              {link.TEXT}
              {external && (
                <svg class="size-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              )}
            </HeaderLink>
          );
        })
      }
    </nav>

    <div class="flex gap-4 items-center shrink-0 lg:min-w-[10rem] justify-end" transition:persist="header-actions">
      <a href="/search" class="hidden sm:inline-flex items-center size-5 text-foreground/70 hover:text-foreground hover:scale-105 transition-transform" aria-label="Search" title="Search">
        <svg class="size-5 stroke-current" aria-hidden="true"><use href="/ui.svg#search"></use></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .nav-pill {
    border-color: oklch(var(--foreground) / 0.1);
    background: oklch(var(--background) / 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav-pill :global(a) {
    border-radius: 9999px;
  }
  #site-header.scrolled {
    background: oklch(var(--background) / 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 0 oklch(var(--border) / 0.6);
  }
  #site-header.scrolled .nav-pill {
    background: transparent;
    backdrop-filter: none;
  }
</style>

<script>
  function onScroll() {
    document.getElementById("site-header")?.classList.toggle("scrolled", window.scrollY > 24);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  document.addEventListener("astro:page-load", onScroll);
  onScroll();
</script>
