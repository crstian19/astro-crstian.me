---
import { LINKS } from "@consts";
import Avatar from "@components/base/Avatar.astro";
import HeaderLink from "@components/base/HeaderLink.astro";
import ThemeToggle from "@components/base/ThemeToggle.astro";
import SectionDivider from "@components/base/SectionDivider.astro";
---

<header class="relative z-[1]">
  <div class="mx-auto global-layout-width flex justify-between px-4 sm:px-8 py-4">
    <div class="flex gap-2 sm:gap-6 items-center flex-shrink-0">
      <a href="/" class="select-none" aria-label="Home">
        <Avatar height={40} class="transition-transform hover:-rotate-6" />
      </a>
      <nav class="flex">
        {
          LINKS.filter((link) => link.HREF !== "/").map((link) => {
            const external = link.HREF.startsWith("http");
            return (
              <HeaderLink href={link.HREF} external={external}>
                {link.TEXT}
                {external && (
                  <svg class="size-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                )}
              </HeaderLink>
            );
          })
        }
      </nav>
    </div>
    <div class="flex gap-3 items-center" transition:persist="header-actions">
      <a href="/search" class="hidden sm:inline-flex items-center size-5 text-foreground/70 hover:text-foreground hover:scale-105 transition-transform" aria-label="Search" title="Search">
        <svg class="size-5 stroke-current" aria-hidden="true"><use href="/ui.svg#search"></use></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
  <div class="relative global-layout-width mx-auto pointer-events-none" aria-hidden="true">
    <div class="absolute inset-x-0 -top-14 bottom-0">
      <div class="absolute bottom-0 left-0 top-0 w-px bg-gradient-to-b from-transparent to-border/50 to-75%"></div>
      <div class="absolute bottom-0 right-0 top-0 w-px bg-gradient-to-b from-transparent to-border/50 to-75%"></div>
    </div>
  </div>
</header>

<SectionDivider class="border-t-border dark:border-t-border/50" />
