---
/**
 * GalaxyBackground.astro
 * Fixed full-screen WebGL starfield behind every page. Persisted across view
 * transitions so the scene isn't rebuilt on each navigation.
 */
---

<div id="galaxy-bg" transition:persist aria-hidden="true">
  <div id="galaxy-canvas"></div>
  <div class="galaxy-glow"></div>
</div>

<script>
  import type { Galaxy } from "./galaxy";

  let galaxy: Galaxy | null = null;
  const theme = () => (document.documentElement.classList.contains("dark") ? "dark" : "light");

  async function start() {
    const container = document.getElementById("galaxy-canvas");
    if (!container || galaxy) return;

    const { createGalaxy } = await import("./galaxy");
    if (galaxy) return;
    galaxy = createGalaxy(container);
    galaxy.setTheme(theme());
    container.classList.add("ready");

    new MutationObserver(() => galaxy?.setTheme(theme())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  start();
  document.addEventListener("astro:page-load", start);
</script>

<style>
  #galaxy-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  #galaxy-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.5s ease;
  }

  #galaxy-canvas.ready {
    opacity: 1;
  }

  :global(html:not(.dark)) #galaxy-canvas.ready {
    opacity: 0.4;
  }

  #galaxy-canvas :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Soft top glow so the hero doesn't sit on flat black */
  .galaxy-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 50% 0%, rgb(var(--accent-1) / 0.18), transparent 70%),
      radial-gradient(40% 35% at 85% 100%, rgb(var(--accent-3) / 0.08), transparent 70%);
  }
</style>
