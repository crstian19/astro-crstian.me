---
type Props = {
	text: string;
	icon: string;
	href: string;
};

const { text, icon, href } = Astro.props;
---

<a href={href} target="_blank" class="w-fit px-3 py-1.5 group rounded-full border flex gap-2 items-center border-black/10 dark:border-white/10 bg-white/40 dark:bg-white/[0.03] backdrop-blur-md hover:border-black/25 dark:hover:border-white/30 hover:bg-white/70 hover:dark:bg-white/10 hover:shadow-[0_0_24px_-6px_rgb(var(--accent-1)/0.7)] blend">
  <svg height={18} width={18}>
    <use href={`/stack.svg#${icon}`}></use>
  </svg>
  <span class="text-sm text-neutral-500 dark:text-neutral-400 group-hover:text-black group-hover:dark:text-white blend">
    {text}
  </span>
</a>