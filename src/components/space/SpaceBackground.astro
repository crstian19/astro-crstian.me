---
/**
 * SpaceBackground.astro
 * Fixed full-screen three.js sky behind every page (see space.ts). Persisted
 * across view transitions so the scene isn't rebuilt on each navigation.
 */
---

<div id="space-bg" transition:persist aria-hidden="true">
  <div id="space-canvas"></div>
</div>

<script>
  type Theme = "dark" | "light";
  type Background = { setTheme(theme: Theme): void; setStars(on: boolean): void; setTwinkle(on: boolean): void };

  let bg: Background | null = null;
  let loading = false;
  const theme = (): Theme => (document.documentElement.classList.contains("dark") ? "dark" : "light");
  // A page can go without stars: <PageLayout stars={false}> sets data-stars="off" on <html>.
  const stars = () => document.documentElement.dataset.stars !== "off";
  // Stars only twinkle where a page asks for it (<PageLayout twinkle>, the home page).
  const twinkle = () => document.documentElement.dataset.twinkle === "on";

  // Without a GPU (software WebGL: SwiftShader, llvmpipe) even one frame of the
  // sky blocks the main thread for hundreds of ms, so those browsers get a still
  // CSS sky instead and never download three.js. PageSpeed Insights runs like this.
  function softwareGL() {
    try {
      const gl = document.createElement("canvas").getContext("webgl");
      if (!gl) return true;
      const info = gl.getExtension("WEBGL_debug_renderer_info");
      const name = String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return /swiftshader|llvmpipe|softpipe|software|basic render/i.test(name);
    } catch {
      return true;
    }
  }

  async function start() {
    const container = document.getElementById("space-canvas");
    if (!container || bg || loading) return;
    loading = true;
    if (softwareGL()) {
      document.getElementById("space-bg")?.classList.add("static-sky");
      return;
    }

    const { createSpace } = await import("./space");
    bg = createSpace(container);
    bg.setTheme(theme());
    bg.setStars(stars());
    bg.setTwinkle(twinkle());
    container.classList.add("ready");

    new MutationObserver(() => {
      bg?.setTheme(theme());
      bg?.setStars(stars());
      bg?.setTwinkle(twinkle());
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class", "data-stars", "data-twinkle"],
    });
  }

  // three.js is the heaviest download on the page: fetch it once the page has
  // loaded and the browser is idle, so it doesn't compete with the first paint.
  // The canvas fades in anyway.
  function startWhenIdle() {
    if ("requestIdleCallback" in window) requestIdleCallback(() => start(), { timeout: 2000 });
    else setTimeout(start, 200);
  }
  if (document.readyState === "complete") startWhenIdle();
  else window.addEventListener("load", startWhenIdle, { once: true });
  document.addEventListener("astro:page-load", () => {
    if (document.readyState === "complete") start();
  });
</script>

<style>
  #space-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--bg-color);
  }

  /* Still sky for browsers without a GPU: the nebula's glows and a few layers of stars. */
  #space-bg.static-sky {
    background:
      radial-gradient(1px 1px at 12% 18%, oklch(var(--foreground) / 0.8), transparent),
      radial-gradient(1px 1px at 68% 9%, oklch(var(--foreground) / 0.7), transparent),
      radial-gradient(1.5px 1.5px at 84% 46%, oklch(var(--foreground) / 0.8), transparent),
      radial-gradient(1px 1px at 37% 63%, oklch(var(--foreground) / 0.6), transparent),
      radial-gradient(1px 1px at 22% 88%, oklch(var(--foreground) / 0.7), transparent),
      radial-gradient(1.5px 1.5px at 56% 33%, oklch(var(--foreground) / 0.6), transparent),
      radial-gradient(1px 1px at 91% 79%, oklch(var(--foreground) / 0.7), transparent),
      radial-gradient(60% 50% at 8% 12%, oklch(0.45 0.12 255 / 0.35), transparent 70%),
      radial-gradient(55% 60% at 92% 70%, oklch(0.42 0.16 310 / 0.35), transparent 70%),
      var(--bg-color);
    background-size: 340px 340px, 260px 260px, 420px 420px, 300px 300px, 380px 380px, 220px 220px, 460px 460px, 100% 100%, 100% 100%, auto;
  }

  #space-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  #space-canvas.ready {
    opacity: 1;
  }

  #space-canvas :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
