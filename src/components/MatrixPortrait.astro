---
/**
 * MatrixPortrait.astro
 * Rain that "prints" the portrait as ASCII inside a circle: each falling drop
 * settles the cells it passes into the photo's glyph and colour, in the site's
 * brand colours. Around the circle, a halo after Magic UI's Glyph Matrix (MIT):
 * a grid of faint glyphs that keep mutating, tinted with the colour of the
 * nearest edge of the photo and fading out with distance, so the portrait
 * dissolves into the sky. Once formed, the portrait itself "breathes": a few
 * cells flicker to a matrix glyph and back. Hovering the circle (or tapping on
 * touch screens) fades it to the real photo; the halo stays.
 */
import { buildPortrait, type PortraitSource } from "@lib/portrait";

interface Props {
  source: PortraitSource;
  alt: string;
  class?: string;
}

// Halo width on each side, as a share of the portrait grid.
const HALO = 0.2;

const { source, alt, class: className } = Astro.props;
const portrait = await buildPortrait(source);
const padCols = Math.round(portrait.cols * HALO);
const padRows = Math.round(portrait.rows * HALO);
const totalCols = portrait.cols + padCols * 2;
const totalRows = portrait.rows + padRows * 2;
const data = JSON.stringify({ ...portrait, photo: undefined, padCols, padRows });
const discInset = `${((padRows / totalRows) * 100).toFixed(3)}% ${((padCols / totalCols) * 100).toFixed(3)}%`;
---

<div class:list={["matrix-portrait", className]} data-matrix={data}>
  <canvas class="matrix-canvas" aria-hidden="true"></canvas>
  <div class="matrix-disc" style={`inset:${discInset}`} role="img" aria-label={alt} tabindex="0">
    <img src={portrait.photo} alt="" aria-hidden="true" class="matrix-photo" decoding="async" />
  </div>
</div>

<style>
  .matrix-portrait {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }

  .matrix-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .matrix-disc {
    position: absolute;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid oklch(var(--foreground) / 0.12);
    box-shadow: 0 30px 80px -30px oklch(var(--brand) / 0.55);
    cursor: crosshair;
    outline: none;
  }

  .matrix-disc:focus-visible {
    outline: 2px solid oklch(var(--ring));
    outline-offset: 3px;
  }

  .matrix-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .matrix-disc:hover .matrix-photo,
  .matrix-disc:focus-visible .matrix-photo,
  .matrix-disc.revealed .matrix-photo {
    opacity: 1;
  }
</style>

<script>
  type Data = { cols: number; rows: number; chars: string[]; colors: number[]; padCols: number; padRows: number };

  // Rain glyphs: half-width katakana, digits and a few symbols, like the film.
  const RAIN_GLYPHS = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:=*+-<>¦";
  // Halo and "breathing" glyphs: Magic UI Glyph Matrix's default set.
  const MATRIX_GLYPHS = "01·•+*/\\<>=";
  const pick = (set: string) => set[(Math.random() * set.length) | 0];

  const FPS = 40;
  const FLASH_MS = 280; // a settled cell glows lavender before taking the photo colour
  const TICK_MS = 90; // Glyph Matrix tick
  const HALO_MUTATION = 0.04; // share of halo cells that change per tick
  const BREATH_RATE = 0.012; // share of portrait cells that flicker per tick

  // Site palette (the --brand tokens): mostly purple drops, some cyan and pink.
  const PURPLE = [122, 92, 255];
  const CYAN = [61, 214, 255];
  const PINK = [255, 79, 163];
  const HEAD = "rgb(236,232,255)";
  const FLASH = [205, 192, 255];
  const DISC_BG = "#030305";
  const pickColor = () => {
    const r = Math.random();
    return r < 0.7 ? PURPLE : r < 0.9 ? CYAN : PINK;
  };

  type Drop = { col: number; head: number; speed: number; trail: number; color: number[] };

  // A cell of the full grid (portrait plus halo).
  type Cell = {
    x: number; // centre, in grid units
    y: number;
    portrait: number; // index into the portrait arrays, -1 for halo cells
    fade: number; // halo only: 1 at the circle's edge, 0 at the halo's outer edge
    color: number[]; // halo only: tint taken from the nearest edge of the photo
  };

  function mount(root: HTMLElement) {
    if (root.dataset.mounted) return;
    root.dataset.mounted = "1";

    const data = JSON.parse(root.dataset.matrix!) as Data;
    const { cols, rows, chars, colors, padCols, padRows } = data;
    const C = cols + padCols * 2;
    const R = rows + padRows * 2;
    const canvas = root.querySelector("canvas")!;
    const disc = root.querySelector<HTMLElement>(".matrix-disc")!;
    const ctx = canvas.getContext("2d")!;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Classify every cell once. Distances are measured in portrait-normalised
    // units so the circle is round even though cells aren't square.
    const cells: Cell[] = [];
    const cellAt = new Int32Array(C * R).fill(-1);
    for (let gy = 0; gy < R; gy++) {
      for (let gx = 0; gx < C; gx++) {
        const nx = (gx + 0.5 - C / 2) / (cols / 2); // -1..1 across the portrait
        const ny = (gy + 0.5 - R / 2) / (rows / 2);
        const dist = Math.hypot(nx, ny);
        const outer = (cols / 2 + padCols) / (cols / 2);
        if (dist > outer) continue; // outside the halo: leave empty
        const px = gx - padCols;
        const py = gy - padRows;
        const inside = dist < 0.985 && px >= 0 && px < cols && py >= 0 && py < rows;
        let color = PURPLE;
        let fade = 0;
        if (!inside) {
          // Tint from the photo just inside the circle, in the same direction.
          const a = Math.atan2(ny, nx);
          const ex = Math.round(cols / 2 + Math.cos(a) * (cols / 2) * 0.9 - 0.5);
          const ey = Math.round(rows / 2 + Math.sin(a) * (rows / 2) * 0.9 - 0.5);
          const e = (Math.min(rows - 1, Math.max(0, ey)) * cols + Math.min(cols - 1, Math.max(0, ex))) * 3;
          // Lift dark edges to a minimum brightness and mix in the brand purple,
          // so the halo still reads on the sky where the photo is dark.
          const edge = [colors[e], colors[e + 1], colors[e + 2]];
          const lum = 0.21 * edge[0] + 0.72 * edge[1] + 0.07 * edge[2];
          const lift = lum < 150 ? 150 / Math.max(lum, 20) : 1;
          color = edge.map((c, k) => Math.round(Math.min(255, c * lift) * 0.55 + PURPLE[k] * 0.45));
          fade = Math.max(0, 1 - (dist - 1) / (outer - 1));
        }
        cellAt[gy * C + gx] = cells.length;
        cells.push({ x: gx + 0.5, y: gy + 0.5, portrait: inside ? py * cols + px : -1, fade, color });
      }
    }

    const settledAt = new Float64Array(cols * rows).fill(-1); // ms timestamp, -1 = not yet
    const insideCount = cells.filter((c) => c.portrait >= 0).length;
    let settledCount = 0;
    const rainGlyph = cells.map(() => pick(RAIN_GLYPHS)); // glyphs shown inside a trail
    // Glyph Matrix state for the halo, and flicker state for the portrait.
    const haloGlyph = cells.map(() => pick(MATRIX_GLYPHS));
    const haloAlpha = cells.map(() => 0.05 + Math.random() * 0.35);
    const breathUntil = new Float64Array(cells.length);
    const breathGlyph = cells.map(() => pick(MATRIX_GLYPHS));

    let drops: Drop[] = [];
    let formed = false;
    let lastTick = 0;
    let cellW = 0;
    let cellH = 0;
    let dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const size = root.clientWidth;
      canvas.width = canvas.height = Math.round(size * dpr);
      cellW = canvas.width / C;
      cellH = canvas.height / R;
      ctx.font = `600 ${Math.floor(cellH * 0.95)}px "Geist Mono", ui-monospace, monospace`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
    }

    // One drop per column for the first pass, staggered so the image builds up unevenly.
    function seed() {
      drops = Array.from({ length: C }, (_, col) => ({
        col,
        head: -Math.random() * R * 0.5,
        speed: 34 + Math.random() * 26, // rows per second
        trail: 6 + ((Math.random() * 10) | 0),
        color: pickColor(),
      }));
    }

    function tick(now: number) {
      // Glyph Matrix: a few halo cells change glyph and brightness.
      for (let i = 0; i < cells.length; i++) {
        const cell = cells[i];
        if (cell.portrait < 0) {
          if (Math.random() < HALO_MUTATION) {
            haloGlyph[i] = pick(MATRIX_GLYPHS);
            haloAlpha[i] = 0.05 + Math.random() * 0.35;
          }
        } else if (formed && Math.random() < BREATH_RATE) {
          breathGlyph[i] = pick(MATRIX_GLYPHS);
          breathUntil[i] = now + TICK_MS * (1 + Math.random() * 2);
        }
      }
    }

    function draw(now: number, dt: number) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Dark disc behind the portrait.
      const cx = canvas.width / 2;
      const cy = canvas.height / 2;
      ctx.beginPath();
      ctx.ellipse(cx, cy, (cols / 2) * cellW, (rows / 2) * cellH, 0, 0, Math.PI * 2);
      ctx.fillStyle = DISC_BG;
      ctx.fill();

      if (now - lastTick >= TICK_MS) {
        lastTick = now;
        tick(now);
      }

      // Advance drops; a drop stamps the portrait cells it crosses.
      for (const drop of drops) {
        const prev = Math.floor(drop.head);
        drop.head += drop.speed * dt;
        for (let row = Math.max(0, prev); row <= Math.min(R - 1, Math.floor(drop.head)); row++) {
          const ci = cellAt[row * C + drop.col];
          const p = ci >= 0 ? cells[ci].portrait : -1;
          if (p >= 0 && settledAt[p] < 0) {
            settledAt[p] = now;
            settledCount++;
          }
        }
      }
      drops = drops.filter((d) => d.head - d.trail < R);
      if (!formed && settledCount >= insideCount) formed = true;

      // Cells under a trail show rain.
      const rain = new Map<number, { v: number; color: number[] }>(); // brightness 0..1 (1 = head)
      for (const drop of drops) {
        const head = Math.floor(drop.head);
        for (let k = 0; k <= drop.trail; k++) {
          const row = head - k;
          if (row < 0 || row >= R) continue;
          const ci = cellAt[row * C + drop.col];
          if (ci < 0) continue;
          const v = k === 0 ? 1 : 0.85 * (1 - k / (drop.trail + 1));
          if ((rain.get(ci)?.v ?? 0) < v) rain.set(ci, { v, color: drop.color });
        }
      }

      for (let i = 0; i < cells.length; i++) {
        const cell = cells[i];
        const x = cell.x * cellW;
        const y = cell.y * cellH;
        const r = rain.get(i);
        // Rain fades out across the halo instead of stopping at the circle.
        const reach = cell.portrait >= 0 ? 1 : cell.fade;

        if (r !== undefined && reach > 0.02) {
          if (Math.random() < 0.08) rainGlyph[i] = pick(RAIN_GLYPHS);
          const [dr, dg, db] = r.color;
          const a = r.v * reach;
          ctx.fillStyle = r.v === 1 && reach === 1 ? HEAD : `rgba(${dr},${dg},${db},${a.toFixed(3)})`;
          ctx.fillText(rainGlyph[i], x, y);
          continue;
        }

        if (cell.portrait < 0) {
          // Halo: Glyph Matrix cell, tinted by the photo, fading with distance.
          const a = haloAlpha[i] * Math.pow(cell.fade, 1.4) * 1.5;
          if (a < 0.02) continue;
          const [hr, hg, hb] = cell.color;
          ctx.fillStyle = `rgba(${hr},${hg},${hb},${Math.min(1, a).toFixed(3)})`;
          ctx.fillText(haloGlyph[i], x, y);
          continue;
        }

        const p = cell.portrait;
        const t = settledAt[p];
        if (t < 0) continue;
        const flicker = breathUntil[i] > now;
        const glyph = flicker ? breathGlyph[i] : chars[(p / cols) | 0][p % cols];
        if (glyph === " ") continue;

        const age = now - t;
        let cr = colors[p * 3];
        let cg = colors[p * 3 + 1];
        let cb = colors[p * 3 + 2];
        if (age < FLASH_MS || flicker) {
          // Fresh or flickering cells lean towards the rain's lavender.
          const f = flicker ? 0.45 : 1 - age / FLASH_MS;
          cr += (FLASH[0] - cr) * f;
          cg += (FLASH[1] - cg) * f;
          cb += (FLASH[2] - cb) * f;
        }
        ctx.fillStyle = `rgb(${cr | 0},${cg | 0},${cb | 0})`;
        ctx.fillText(glyph, x, y);
      }

      // Ambient rain once the portrait is complete: sparse, short-lived drops.
      if (formed && drops.length < 6 && Math.random() < dt * 3) {
        drops.push({
          col: (Math.random() * C) | 0,
          head: -2,
          speed: 32 + Math.random() * 22,
          trail: 5 + ((Math.random() * 8) | 0),
          color: pickColor(),
        });
      }
    }

    function drawStill() {
      settledAt.fill(0);
      settledCount = insideCount;
      formed = true;
      drops = [];
      draw(FLASH_MS * 10, 0);
    }

    resize();
    new ResizeObserver(() => {
      resize();
      if (reducedMotion) drawStill();
    }).observe(root);

    // Tap on touch screens toggles the photo.
    disc.addEventListener("click", () => {
      if (window.matchMedia("(hover: none)").matches) disc.classList.toggle("revealed");
    });

    if (reducedMotion) {
      drawStill();
      return;
    }

    seed();
    let frame = 0;
    let last = 0;
    let visible = false;

    function loop(now: number) {
      frame = requestAnimationFrame(loop);
      if (now - last < 1000 / FPS) return;
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 1 / FPS;
      last = now;
      draw(now, dt);
    }

    const start = () => {
      if (!frame && visible && !document.hidden) frame = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      last = 0;
    };

    // Only animate while on screen; the first pass starts when it scrolls into view.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
      else stop();
    }).observe(root);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-matrix]").forEach(mount);
  }

  // Load Geist Mono first so the first frames don't fall back to another font.
  document.fonts.load('600 16px "Geist Mono"').then(init, init);
  document.addEventListener("astro:page-load", init);
</script>
