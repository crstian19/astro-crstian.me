---
import { cn } from "@lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class={cn("border-y border-border/50 z-[1] relative", className)} aria-hidden="true">
  <div class="h-1.5 w-full bg-[repeating-linear-gradient(-45deg,oklch(var(--border)),oklch(var(--border))_1px,transparent_1px,transparent_6px)] opacity-50"></div>
</section>
