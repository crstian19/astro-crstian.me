---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
};

const { href, external } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = !external && (path === href || path.startsWith(`${href}/`));
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  class={cn(
    "text-sm px-2 sm:px-4 py-2 font-medium inline-flex items-center gap-1 transition-colors text-foreground/50 hover:bg-accent hover:text-foreground",
    isActive && "text-primary hover:text-primary",
  )}
>
  <slot />
</a>
