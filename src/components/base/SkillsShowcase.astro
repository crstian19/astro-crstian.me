---
import { cn } from "@lib/utils";
import { STACK, type StackKey } from "@consts";

interface Props {
  rows: { direction: "left" | "right"; skills: StackKey[] }[];
}

const { rows } = Astro.props;
---

<div class="skills-container relative isolate py-2">
  {rows.map((row) => {
    // Four copies so the loop never shows a gap; the animation moves by 25%.
    const skills = [...row.skills, ...row.skills, ...row.skills, ...row.skills];
    return (
      <div class="relative w-full overflow-hidden my-3 group">
        <div class={cn("flex w-max will-change-transform group-hover:[animation-play-state:paused]", row.direction === "right" ? "marquee-right" : "marquee-left")}>
          {skills.map((key, i) => (
            <a
              href={STACK[key].href}
              target="_blank"
              rel="noopener noreferrer"
              class="pill mx-1.5"
              tabindex={i >= row.skills.length ? -1 : undefined}
              aria-hidden={i >= row.skills.length ? "true" : undefined}
            >
              <svg class="size-5 shrink-0" aria-hidden="true"><use href={`/stack.svg#${key}`} /></svg>
              <span>{STACK[key].text}</span>
            </a>
          ))}
        </div>
      </div>
    );
  })}
</div>

<style>
  .marquee-left {
    animation: scroll 40s linear infinite;
  }
  .marquee-right {
    animation: scroll-reverse 40s linear infinite;
  }
  @keyframes scroll {
    to {
      transform: translate3d(-25%, 0, 0);
    }
  }
  @keyframes scroll-reverse {
    from {
      transform: translate3d(-25%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }
  .skills-container {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-left,
    .marquee-right {
      animation: none;
    }
  }
</style>
