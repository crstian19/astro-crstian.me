---
import { SITE, SOCIALS } from "@consts";
import SectionDivider from "@components/base/SectionDivider.astro";
import ThemeToggle from "@components/base/ThemeToggle.astro";

const START_YEAR = 2019;
const year = new Date().getFullYear();

const links = [
  { text: "Home", href: "/" },
  { text: "Work", href: "/work" },
  { text: "Projects", href: "/projects" },
  // proxied to the talks project: a full page load, not the client router
  { text: "Talks", href: "/talks/", reload: true },
  { text: "Blog", href: "https://blog.crstian.me/" },
  { text: "Search", href: "/search" },
  { text: "Terms", href: "/legal/terms" },
  { text: "Privacy", href: "/legal/privacy" },
];
---

<footer class="relative z-[1] mt-24">
  <SectionDivider />
  <div class="footer-glass">
    <div class="frame py-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-8">
        <div>
          <a href="/" class="display text-2xl gradient-text w-fit block">{SITE.AUTHOR}</a>
          <p class="mt-1 text-sm text-muted-foreground">SRE / AI Platform Engineer</p>
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
          {links.map((link) => (
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} data-astro-reload={link.reload ? true : undefined} class="text-muted-foreground/80 hover:text-primary transition">
              {link.text}
            </a>
          ))}
        </div>
      </div>
      <div class="mt-10 pt-6 border-t border-border/50 flex flex-wrap items-center gap-4 text-sm text-muted-foreground font-medium">
        <div class="flex flex-wrap items-center gap-x-1.5">
          <span>© {START_YEAR}–{year}</span>
          <span aria-hidden="true">·</span>
          <span>Made by {SITE.AUTHOR} from Murcia</span>
          <span class="inline-flex gap-[3px] ml-0.5">
            <svg class="footer-flag" viewBox="0 0 30 20" role="img" aria-label="Flag of the Region of Murcia">
              <rect width="30" height="20" fill="#B4132E" />
              <g fill="#F9C623">
                <rect x="3" y="3" width="3.4" height="3" />
                <rect x="8" y="3" width="3.4" height="3" />
                <rect x="3" y="8" width="3.4" height="3" />
                <rect x="8" y="8" width="3.4" height="3" />
                <circle cx="16" cy="12.5" r="1.1" />
                <circle cx="20" cy="12.5" r="1.1" />
                <circle cx="24" cy="12.5" r="1.1" />
                <circle cx="28" cy="12.5" r="1.1" />
                <circle cx="18" cy="16" r="1.1" />
                <circle cx="22" cy="16" r="1.1" />
                <circle cx="26" cy="16" r="1.1" />
              </g>
            </svg>
            <svg class="footer-flag" viewBox="0 0 30 20" role="img" aria-label="Flag of Spain">
              <rect width="30" height="20" fill="#AA151B" />
              <rect y="5" width="30" height="10" fill="#F1BF00" />
            </svg>
          </span>
        </div>
        <div class="grow"></div>
        <div class="flex gap-3 items-center">
          {SOCIALS.map((social) => (
            <a href={social.HREF} target="_blank" rel={social.REL ? `${social.REL} noopener` : "noopener"} aria-label={social.NAME} title={social.NAME} class="inline-flex text-muted-foreground hover:text-primary hover:scale-105 transition">
              <span class:list={[social.ICON, "size-[18px]"]} aria-hidden="true"></span>
            </a>
          ))}
          <span class="w-px h-4 bg-border" aria-hidden="true"></span>
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-glass {
    background: linear-gradient(to bottom, oklch(var(--background) / 0.4), oklch(var(--background) / 0.85));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .footer-flag {
    height: 0.92em;
    width: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px oklch(var(--foreground) / 0.12);
  }
</style>
