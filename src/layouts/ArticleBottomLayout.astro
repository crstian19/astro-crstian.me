---
import { type CollectionEntry, getCollection, render } from "astro:content";

type Props = {
	entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
const { collection } = entry;
const { Content } = await render(entry);

// Next and previous entries, wrapping around the ends
const items = (await getCollection(collection))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const index = items.findIndex((x) => x.id === entry.id);
const prev = items[(index - 1 + items.length) % items.length];
const next = items[(index + 1) % items.length];
---

<div>
  <article class="pb-10">
    <Content />
  </article>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href={`/${prev.collection}/${prev.id}`} class="panel group p-5">
      <div class="font-mono text-xs text-muted-foreground">&larr; Previous</div>
      <div class="mt-1 font-medium group-hover:text-primary transition-colors">{prev.data.title}</div>
    </a>
    <a href={`/${next.collection}/${next.id}`} class="panel group p-5 text-right">
      <div class="font-mono text-xs text-muted-foreground">Next &rarr;</div>
      <div class="mt-1 font-medium group-hover:text-primary transition-colors">{next.data.title}</div>
    </a>
  </div>
</div>
