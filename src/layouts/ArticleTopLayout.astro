---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate, readingTime } from "@lib/utils";

type Props = {
	entry: CollectionEntry<"projects"> | CollectionEntry<"blog">;
};

const { entry } = Astro.props;
const { collection, data, body } = entry;
const { title, summary, date } = data;

const demoUrl = collection === "projects" ? data.demoUrl : null;
const repoUrl = collection === "projects" ? data.repoUrl : null;
const tags = collection === "projects" ? data.tags : [];
const logo = collection === "projects" ? data.logo : undefined;
const logoBg = collection === "projects" ? data.logoBg : undefined;
---

<div>
  <a href={`/${collection}`} class="group inline-flex items-center gap-1.5 text-sm link-muted">
    <span class="inline-block transition-transform group-hover:-translate-x-1">&larr;</span>
    Back to {collection}
  </a>
  {
    logo && (
      <div
        class="mt-8 size-24 sm:size-28 rounded-3xl p-3 grid place-items-center overflow-hidden border border-foreground/10 shadow-[0_20px_60px_-24px_oklch(var(--brand)/0.7)]"
        style={`background:${logoBg ?? "oklch(var(--foreground) / 0.06)"}`}
      >
        <Image src={logo} alt={`${title} logo`} width={224} class="size-full object-contain" />
      </div>
    )
  }
  <div class="mt-8 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted-foreground">
    <span>{formatDate(date)}</span>
    <span aria-hidden="true">·</span>
    <span>{readingTime(body ?? "")}</span>
  </div>
  <h1 class="mt-3 display text-4xl sm:text-6xl gradient-text w-fit pb-2">
    {title}
  </h1>
  <p class="mt-2 text-lg text-muted-foreground text-pretty">{summary}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
  {
    (demoUrl || repoUrl) && (
      <div class="mt-6 flex flex-wrap gap-2">
        {demoUrl && (
          <a href={demoUrl} target="_blank" class="btn-primary">
            <svg class="size-4 fill-current" aria-hidden="true"><use href="/ui.svg#globe" /></svg>
            See demo
          </a>
        )}
        {repoUrl && (
          <a href={repoUrl} target="_blank" class="btn-ghost">
            <svg class="size-4 fill-current" aria-hidden="true"><use href="/ui.svg#link" /></svg>
            See repository
          </a>
        )}
      </div>
    )
  }
</div>
