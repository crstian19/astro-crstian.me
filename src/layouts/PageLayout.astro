---
import "@styles/global.css";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SpaceBackground from "@components/space/SpaceBackground.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={`${title} | ${SITE.TITLE}`} description={description} />
    <script defer src="https://umami.crstian.me/script.js" data-website-id="69d68ece-9d7a-49fe-a40b-a1f2d9d20a0a"></script>
    <script src="https://app.rybbit.io/api/script.js" data-site-id="5e63b1ad9747" defer></script>
  </head>

  <body>
    <SpaceBackground />
    <Header />
    <div class="grow flex relative z-[1]">
      <main class="relative border-x border-border/50 global-layout-width mx-auto grow min-w-0 bg-background/75">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
